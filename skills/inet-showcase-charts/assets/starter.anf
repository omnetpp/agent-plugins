<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<analysis version="2">
    <inputs>
        <input pattern="results/*.sca"/>
        <input pattern="results/*.vec"/>
    </inputs>
    <charts>
        <chart id="1" name="CHANGE ME" type="MATPLOTLIB" template="generic_mpl"
               icon="icons/full/obj/linechart.png" resultTypes="" createdWith="">
            <script><![CDATA[from omnetpp.scave import results, chart, utils
import matplotlib.pyplot as plt

props = chart.get_properties()
utils.preconfigure_plot(props)

# --- query: edit the filter to select your results ---
df = results.get_scalars('name =~ "SOME:stat" AND module =~ "*.host[*].app[0]"',
                         include_runattrs=True, include_itervars=True)
if df.empty:
    raise chart.ChartScriptError("The result filter returned no data.")

# --- plot: replace with your figure ---
fig, ax = plt.subplots()
ax.bar(df["module"], df["value"])
ax.set_ylabel("value")
plt.tight_layout()

# --- mandatory export hook (must be last) ---
utils.export_image_if_needed(props)
]]></script>
        <property name="image_export_filename" value="change-me"/>
        </chart>
    </charts>
</analysis>
